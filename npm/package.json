{
  "name": "sanzhi-yunxiao-cli",
  "version": "0.16.21",
  "description": "Yunxiao (云效) CLI — Feishu-style install (GitHub Releases)",
  "bin": {
    "yunxiao": "scripts/run.js"
  },
  "scripts": {
    "postinstall": "node scripts/install.js"
